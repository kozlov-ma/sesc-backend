#!/bin/sh

# Post-accessory-boot hook to configure MinIO proxy after accessory reboot
# This runs after accessory container starts

# Check if this is MinIO accessory
if [ "$KAMAL_ACCESSORY" = "minio" ]; then
  echo "Configuring MinIO proxy after reboot..."
  
  # Wait a bit for MinIO to fully start
  sleep 2
  
  # Configure MinIO proxy with health check parameters
  docker exec kamal-proxy kamal-proxy deploy sesc-backend-minio \
    --target='sesc-backend-minio:9000' \
    --host='s3.sesc-fiit.ru' \
    --tls \
    --deploy-timeout='60s' \
    --health-check-path='/minio/health/live' \
    --health-check-interval='1s' 2>/dev/null || true
  
  echo "MinIO proxy reconfigured successfully"
fi

